<?xml version="1.0" encoding="utf-8"?>
<!-- 自由な小窓（ポップアップ再生）。ほかのアプリの上に重ねて表示する -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_popup_window">

    <!--
        映像と字幕を描く場所。libVLC の VLCVideoLayout は、画面（Activity）の中でないと
        描く大きさを VLC に伝えないので、小窓では自分で伝える（PopupPlayer.kt）。
        窓いっぱいに置く（窓の比は動画に合わせてあるので、黒い隙間が出ない）
    -->
    <FrameLayout
        android:id="@+id/popupVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/popupSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <SurfaceView
            android:id="@+id/popupSubtitles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- タップ・ドラッグ（移動）・ピンチ（大きさ）を受け取る透明なレイヤー -->
    <View
        android:id="@+id/popupTouch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- タップすると出るボタン（ここ自体はタッチを受け取らず、下のレイヤーに渡す） -->
    <FrameLayout
        android:id="@+id/popupControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_popup_controls">

        <!-- 閉じる：全画面ボタンの左隣（PopupGeometry の CORNER_DP） -->
        <ImageButton
            android:id="@+id/popupClose"
            style="@style/PopupButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="36dp"
            android:contentDescription="@string/close"
            android:padding="7dp"
            android:src="@drawable/ic_close" />

        <ImageButton
            android:id="@+id/popupExpand"
            style="@style/PopupButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/expand"
            android:padding="7dp"
            android:src="@drawable/ic_fullscreen" />

        <!-- 真ん中のボタンの列。右上のボタンにかかるときは下へずらす（PopupGeometry.rowCenterY） -->
        <LinearLayout
            android:id="@+id/popupRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/popupRewind"
                style="@style/PopupButton"
                android:contentDescription="@string/rewind"
                android:src="@drawable/ic_stat_rewind" />

            <ImageButton
                android:id="@+id/popupPrev"
                style="@style/PopupButton"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/popupPlay"
                style="@style/PopupButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/play_pause"
                android:padding="7dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/popupNext"
                style="@style/PopupButton"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_skip_next" />

            <ImageButton
                android:id="@+id/popupForward"
                style="@style/PopupButton"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_stat_forward" />
        </LinearLayout>

        <!-- 右下のつまみ：ドラッグで大きさを変える -->
        <ImageView
            android:id="@+id/popupResize"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/resize"
            android:padding="4dp"
            android:src="@drawable/ic_resize" />

        <ProgressBar
            android:id="@+id/popupProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#66FFFFFF" />
    </FrameLayout>

    <!--
        端にしまったときに、画面に残る帯（PopupGeometry の STASH_VISIBLE_DP と同じ幅）。
        しまった側と反対の端に出す。タッチは受け取らず、下のレイヤーに渡す（タップで戻す）
    -->
    <ImageView
        android:id="@+id/popupStashTab"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone" />

    <!-- 映像を出せなかったときだけ、どこで止まったかを出す（不具合を調べるため） -->
    <TextView
        android:id="@+id/popupStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
