<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 上部：閉じる・タイトル・その他 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/closeButton"
            style="@style/PlayerButton"
            android:layout_width="48dp"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_expand_more" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/player_now_playing"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/moreButton"
            style="@style/PlayerButton"
            android:layout_width="48dp"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- ジャケット（正方形の大きさはコードで決める） -->
    <FrameLayout
        android:id="@+id/artContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/artCard"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/audio_side">

        <com.ryose.videoplayer.MiddleEllipsisTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <!-- A-B リピートの操作（メニューから開いたとき・使っているときだけ出す） -->
        <include
            layout="@layout/view_ab_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- A-B リピートの区間はシークバーの後ろに描く -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.ryose.videoplayer.AbRangeView
                android:id="@+id/abRange"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCurrent"
                style="@style/PlayerTime"
                android:gravity="start"
                android:text="@string/player_time_zero"
                android:textColor="@color/text_muted" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timeDuration"
                style="@style/PlayerTime"
                android:gravity="end"
                android:text="@string/player_time_zero"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- 再生操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/audio_side_controls">

        <ImageButton
            android:id="@+id/shuffleButton"
            style="@style/AudioControlButton"
            android:contentDescription="@string/shuffle"
            android:src="@drawable/ic_shuffle" />

        <!-- 何秒か戻す・進む（秒数は設定の「スキップする秒数」） -->
        <ImageButton
            android:id="@+id/rewindButton"
            style="@style/AudioControlButton"
            android:contentDescription="@string/rewind"
            android:src="@drawable/ic_rewind" />

        <ImageButton
            android:id="@+id/prevButton"
            style="@style/AudioControlButton"
            android:contentDescription="@string/player_prev_neutral"
            android:paddingVertical="12dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_play_big"
            android:contentDescription="@string/play_pause"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/nextButton"
            style="@style/AudioControlButton"
            android:contentDescription="@string/player_next_neutral"
            android:paddingVertical="12dp"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/forwardButton"
            style="@style/AudioControlButton"
            android:contentDescription="@string/forward"
            android:src="@drawable/ic_fast_forward" />

        <ImageButton
            android:id="@+id/repeatButton"
            style="@style/AudioControlButton"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <!-- 速度・スリープタイマー・イコライザー・キュー -->
    <LinearLayout
        android:id="@+id/bottomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/audio_side"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/speedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focus_button"
            android:contentDescription="@string/speed"
            android:focusable="true"
            android:gravity="center"
            tools:text="1x"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/timerButton"
            style="@style/PlayerButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/sleep_timer"
            android:src="@drawable/ic_timer" />

        <ImageButton
            android:id="@+id/eqButton"
            style="@style/PlayerButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/equalizer"
            android:src="@drawable/ic_equalizer" />

        <ImageButton
            android:id="@+id/queueButton"
            style="@style/PlayerButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/queue"
            android:src="@drawable/ic_queue" />
    </LinearLayout>
</LinearLayout>
