<?xml version="1.0" encoding="utf-8"?>
<!-- タブレットなど幅の広い画面：タブを左に縦に並べる（id は縦長の画面と同じ） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 高さは最低 actionBarSize、文字を大きくした端末では 2 行目（「125 本の動画」など）が欠けないように広がる -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/bottomNav"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/surface"
            app:labelVisibilityMode="labeled"
            app:itemBackground="@drawable/bg_focus_button"
            app:itemTextAppearanceActive="@style/TextAppearance.Orbit.RailLabel"
            app:itemTextAppearanceInactive="@style/TextAppearance.Orbit.RailLabel"
            app:menu="@menu/bottom_nav"
            app:menuGravity="center"
            app:paddingTopSystemWindowInsets="false" />

        <!-- 右側の列。id は幅の広い画面だけにある（MainActivity は無ければ何もしない）。
             中でも weight を使うが、画面の組み立て直しはまれなので、重さは気にしなくてよい -->
        <LinearLayout
            android:id="@+id/contentColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:ignore="InconsistentLayout,NestedWeights">

            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 再生中の曲・動画のミニプレイヤー（中身は view_mini_player.xml。縦長と幅の広い画面で共通） -->
            <include layout="@layout/view_mini_player" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
